n imponen *costos ocultos*\n\n. . .\n\n{{< fa arrow-right >}} Ítem placebo puede sustituir un tipo de sesgo por otro\n\n::: {style=\"text-align: center\"}\n## ¡Nos pasó a nosotros!\n:::\n\n# Nuestro experimento\n\n## Double list experiment\n\nHa experimentado (en su barrio) en los últimos seis meses:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<!-- preamble start -->\n\n    <script src=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.js\"></script>\n\n    <script>\n      // Create table-specific functions using external factory\n      const tableFns_3qu3enszyf6051lvtsvz = TinyTable.createTableFunctions(\"tinytable_3qu3enszyf6051lvtsvz\");\n      // tinytable span after\n      window.addEventListener('load', function () {\n          var cellsToStyle = [\n            // tinytable style arrays after\n          { positions: [ { i: '4', j: 1 }, { i: '4', j: 2 } ], css_id: 'tinytable_css_fpeojfj95m9rfnnf86uy',}, \n          { positions: [ { i: '1', j: 1 }, { i: '2', j: 1 }, { i: '3', j: 1 }, { i: '1', j: 2 }, { i: '2', j: 2 }, { i: '3', j: 2 } ], css_id: 'tinytable_css_ayy7mny3pl49n5a54epg',}, \n          { positions: [ { i: '0', j: 1 }, { i: '0', j: 2 } ], css_id: 'tinytable_css_24d3eu0c0sw47c1caw1u',}, \n          ];\n\n          // Loop over the arrays to style the cells\n          cellsToStyle.forEach(function (group) {\n              group.positions.forEach(function (cell) {\n                  tableFns_3qu3enszyf6051lvtsvz.styleCell(cell.i, cell.j, group.css_id);\n              });\n          });\n      });\n    </script>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.css\">\n    <style>\n    /* tinytable css entries after */\n    #tinytable_3qu3enszyf6051lvtsvz td.tinytable_css_fpeojfj95m9rfnnf86uy, #tinytable_3qu3enszyf6051lvtsvz th.tinytable_css_fpeojfj95m9rfnnf86uy {  position: relative; --border-bottom: 1; --border-left: 0; --border-right: 0; --bord