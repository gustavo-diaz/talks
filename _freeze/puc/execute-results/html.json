as en sesgo/varianza que no comprometen la otra dimensión imponen *costos ocultos*\n\n. . .\n\n{{< fa arrow-right >}} Ítem placebo puede sustituir un tipo de sesgo por otro\n\n# ¡Nos pasó a nosotros!\n\n## Doble experimento de lista\n\nHa experimentado (en su barrio) en los últimos seis meses:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<!-- preamble start -->\n\n    <script src=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.js\"></script>\n\n    <script>\n      // Create table-specific functions using external factory\n      const tableFns_npcix933h7huwru1bym2 = TinyTable.createTableFunctions(\"tinytable_npcix933h7huwru1bym2\");\n      // tinytable span after\n      window.addEventListener('load', function () {\n          var cellsToStyle = [\n            // tinytable style arrays after\n          { positions: [ { i: '4', j: 1 }, { i: '4', j: 2 } ], css_id: 'tinytable_css_008esdh79dz9vr80xieg',}, \n          { positions: [ { i: '1', j: 1 }, { i: '2', j: 1 }, { i: '3', j: 1 }, { i: '1', j: 2 }, { i: '2', j: 2 }, { i: '3', j: 2 } ], css_id: 'tinytable_css_6zw47s65eu4lgl8h70vi',}, \n          { positions: [ { i: '0', j: 1 }, { i: '0', j: 2 } ], css_id: 'tinytable_css_6bv3uks6rwgnsh0zbu2u',}, \n          ];\n\n          // Loop over the arrays to style the cells\n          cellsToStyle.forEach(function (group) {\n              group.positions.forEach(function (cell) {\n                  tableFns_npcix933h7huwru1bym2.styleCell(cell.i, cell.j, group.css_id);\n              });\n          });\n      });\n    </script>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.css\">\n    <style>\n    /* tinytable css entries after */\n    #tinytable_npcix933h7huwru1bym2 td.tinytable_css_008esdh79dz9vr80xieg, #tinytable_npcix933h7huwru1bym2 th.tinytable_css_008esdh79dz9vr80xieg {  position: relative; --border-bottom: 1; --border-left: 0; --border-right: 0; --border-top: