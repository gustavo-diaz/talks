\n{{< fa arrow-right >}} Ítem placebo puede sustituir un tipo de sesgo por otro\n\n# ¡Nos pasó a nosotros!\n\n## Doble experimento de lista\n\nHa experimentado (en su barrio) en los últimos seis meses:\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<!-- preamble start -->\n\n    <script src=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.js\"></script>\n\n    <script>\n      // Create table-specific functions using external factory\n      const tableFns_3kqe29vavn874zsrzwyv = TinyTable.createTableFunctions(\"tinytable_3kqe29vavn874zsrzwyv\");\n      // tinytable span after\n      window.addEventListener('load', function () {\n          var cellsToStyle = [\n            // tinytable style arrays after\n          { positions: [ { i: '4', j: 1 }, { i: '4', j: 2 } ], css_id: 'tinytable_css_z232wc4sxzi75vz0hrgm',}, \n          { positions: [ { i: '1', j: 1 }, { i: '2', j: 1 }, { i: '3', j: 1 }, { i: '1', j: 2 }, { i: '2', j: 2 }, { i: '3', j: 2 } ], css_id: 'tinytable_css_unjh4k7dmti64hjhetsc',}, \n          { positions: [ { i: '0', j: 1 }, { i: '0', j: 2 } ], css_id: 'tinytable_css_yoju7c18d8dgohxhuwb0',}, \n          ];\n\n          // Loop over the arrays to style the cells\n          cellsToStyle.forEach(function (group) {\n              group.positions.forEach(function (cell) {\n                  tableFns_3kqe29vavn874zsrzwyv.styleCell(cell.i, cell.j, group.css_id);\n              });\n          });\n      });\n    </script>\n\n    <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.css\">\n    <style>\n    /* tinytable css entries after */\n    #tinytable_3kqe29vavn874zsrzwyv td.tinytable_css_z232wc4sxzi75vz0hrgm, #tinytable_3kqe29vavn874zsrzwyv th.tinytable_css_z232wc4sxzi75vz0hrgm {  position: relative; --border-bottom: 1; --border-left: 0; --border-right: 0; --border-top: 0; --line-color-bottom: var(--tt-line-color); --line-color-left: var(--tt-line-color); --lin