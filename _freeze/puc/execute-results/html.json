                <th scope=\"col\" data-row=\"0\" data-col=\"1\">Control</th>\n                <th scope=\"col\" data-row=\"0\" data-col=\"2\">Tratamiento</th>\n              </tr>\n        </thead>\n        \n        <tbody>\n                <tr>\n                  <td data-row=\"1\" data-col=\"1\">Gobierno sube el impuesto a la bencina</td>\n                  <td data-row=\"1\" data-col=\"2\">Gobierno sube el impuesto a la bencina</td>\n                </tr>\n                <tr>\n                  <td data-row=\"2\" data-col=\"1\">Futbolistas reciben salarios millonarios</td>\n                  <td data-row=\"2\" data-col=\"2\">Futbolistas reciben salarios millonarios</td>\n                </tr>\n                <tr>\n                  <td data-row=\"3\" data-col=\"1\">Empresas contaminan el medio ambiente</td>\n                  <td data-row=\"3\" data-col=\"2\">Empresas contaminan el medio ambiente</td>\n                </tr>\n                <tr>\n                  <td data-row=\"4\" data-col=\"1\"></td>\n                  <td data-row=\"4\" data-col=\"2\"><strong>Familia venezolana se muda al lado</strong></td>\n                </tr>\n        </tbody>\n      </table>\n    </div>\n<!-- hack to avoid NA insertion in last line -->\n```\n\n:::\n:::\n\n\n. . .\n\n&nbsp;\n\n:::{.r-stack}\nLista tratamiendo es más larga\n:::\n. . .\n\n:::{.r-stack}\n{{< fa arrow-down >}}\n:::\n\n:::{.r-stack}\nEstimación positiva de manera artificial\n:::\n\n## Error no estratégico\n\n**Cosas que molestan**\n\n\n::: {.cell}\n::: {.cell-output-display}\n\n```{=html}\n<!-- preamble start -->\n\n    <script src=\"https://cdn.jsdelivr.net/gh/vincentarelbundock/tinytable@main/inst/tinytable.js\"></script>\n\n    <script>\n      // Create table-specific functions using external factory\n      const tableFns_dij3qzl6wac6j0l7zdz7 = TinyTable.createTableFunctions(\"tinytable_dij3qzl6wac6j0l7zdz7\");\n      // tinytable span after\n      window.addEventListener('load', function () {\n         